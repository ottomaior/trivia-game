    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.27.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  }
